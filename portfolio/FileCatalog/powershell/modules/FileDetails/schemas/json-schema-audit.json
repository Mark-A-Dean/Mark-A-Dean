{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "",
    "type": "object",
    "properties": {
        "auditor": {
            "type": "string",
            "minLength": 1
        },
        "event_name": {
            "type": "string",
            "minLength": 1
        },
        "directory_path": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "event_date": {
            "type": "string",
            "minLength": 1
        },
        "event_state": {
            "type": "string",
